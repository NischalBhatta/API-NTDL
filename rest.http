#Not to do list API
@baseURL = http://localhost:8000/api/v1/tasks


### POST the task list
POST {{baseURL}}
Content-Type: application/json


{
    "id": "3",
    "task": "Cooking",
    "hr": 20,
    "type": "entry"
}



### GET the task list
GET {{baseURL}}


### PUT the task list
PATCH {{baseURL}}
Content-Type: application/json


{
    "id": 2,
    "type": "bad"
}




### DELETE the task list
DELETE {{baseURL}}
Content-Type: application/json


[
    "6a8159563e9ebdb8d7206716",
    "6a815b2a7e7220fa09457fe3"
]
    

